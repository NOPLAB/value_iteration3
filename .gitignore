# Top-level EDF checkout (outside vi_fpga)
edf/

# C object files (global)
*.o

# OS / Vivado / Vitis tool logs
.Xil/
*.jou
*.log
*.str

# colcon workspace + generated cargo config (created by scripts/ros2_build.sh)
