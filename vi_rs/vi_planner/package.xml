<?xml version="1.0"?>
<package format="3">
  <name>vi_planner</name>
  <version>0.1.0</version>
  <description>
    Unified value-iteration planner for Nav2: one Rust node serving both the
    compute_path_to_pose and follow_path actions (nav2_msgs) from a single
    value function.
  </description>
  <maintainer email="noplab90@gmail.com">nop</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cargo</buildtool_depend>

  <depend>rclrs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cargo</build_type>
    <install>launch</install>
  </export>
</package>
